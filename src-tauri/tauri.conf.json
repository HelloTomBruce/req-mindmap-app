{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReqMindmark",
  "version": "1.0.0",
  "identifier": "com.reqmindmark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReqMindmark - 需求规格说明书工作台",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyRDRGOUYwM0M0NTEwNzgKUldSY01PdnB3TUZ2TFNkdm82SmpUUk9kNWZkdnN1WGNrRGRvYnR3ZHFadUR4TGJsc0FrcUNiNlQK",
      "endpoints": [
        "https://github.com/reqmindmark/req-mindmark-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "app"],
    "publisher": "ReqMindmark Team",
    "shortDescription": "需求规格说明书工作台",
    "longDescription": "基于 Markdown 与 MCP 协议的可视化需求树与跨工具协同工作台",
