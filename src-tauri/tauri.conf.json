{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocMind",
  "version": "1.4.1",
  "identifier": "com.docmind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocMind - 结构化文档与知识工作台",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMDFCMzMyNjEyMUY0OUUKUldTZTlDRmhNck1CY2g4enlQTkhyUDQ2b1pQUmtUTVdLV0lkREc5U3BhWkp1UG9jb3ordjgrMC8K",
      "endpoints": [
        "https://github.com/HelloTomBruce/req-mindmap-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "app"],
    "publisher": "ReqMindmark Team",
    "createUpdaterArtifacts": true,
    "shortDescription": "需求规格说明书工作台",
    "longDescription": "基于 Markdown 与 MCP 协议的可视化需求树与跨工具协同工作台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
